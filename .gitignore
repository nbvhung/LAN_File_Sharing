.m2/
*.iml
runtime/
*.log
*.part
*.tmp
# Keep only reviewed experiment and release evidence under version control.
statics/results/*.csv
!statics/results/phase09-*.csv
!statics/results/phase10-*.csv
!statics/results/.gitkeep
